{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMDB Assistant: Build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CmdbAssistant.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "CMDB Assistant: Run API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/CmdbAssistant.Api/CmdbAssistant.Api.csproj",
        "--no-launch-profile"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5072"
        }
      },
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}